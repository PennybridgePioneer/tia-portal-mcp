<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tia-mcp</ToolCommandName>
    <PackageId>TiaMcpServer</PackageId>
    <Description>Model Context Protocol (MCP) server for Siemens SIMATIC TIA Portal V21. Enables MCP
      clients and AI agents to inspect, diagnose, and automate TIA Portal projects via Siemens
      Openness.</Description>
    <PackageTags>mcp;model-context-protocol;tia-portal;siemens;automation;plc;openness</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.402" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TiaMcpServer.Contracts\TiaMcpServer.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <Target Name="BuildOpennessWorkers" BeforeTargets="Build">
    <MSBuild Projects="..\TiaMcpServer.OpennessWorker\TiaMcpServer.OpennessWorker.V21.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration)"
      RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;SelfContained;PackAsTool" />
    <MSBuild Projects="..\TiaMcpServer.OpennessWorker\TiaMcpServer.OpennessWorker.V20.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration)"
      RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;SelfContained;PackAsTool" />
  </Target>

  <Target Name="CopyOpennessWorkers" AfterTargets="Build" BeforeTargets="PackTool">
    <RemoveDir Directories="$(OutputPath)openness-worker" />

    <ItemGroup>
      <OpennessWorkerV21Files
        Include="..\TiaMcpServer.OpennessWorker\bin\V21\$(Configuration)\**\*.*"
        Exclude="..\TiaMcpServer.OpennessWorker\bin\V21\$(Configuration)\**\Siemens.Engineering*.dll;..\TiaMcpServer.OpennessWorker\bin\V21\$(Configuration)\**\*.runtimeconfig.json" />
      <OpennessWorkerV20Files
        Include="..\TiaMcpServer.OpennessWorker\bin\V20\$(Configuration)\**\*.*"
        Exclude="..\TiaMcpServer.OpennessWorker\bin\V20\$(Configuration)\**\Siemens.Engineering*.dll;..\TiaMcpServer.OpennessWorker\bin\V20\$(Configuration)\**\*.runtimeconfig.json" />
    </ItemGroup>

    <Copy SourceFiles="@(OpennessWorkerV21Files)"
      DestinationFiles="@(OpennessWorkerV21Files->'$(OutputPath)openness-worker\V21\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(OpennessWorkerV20Files)"
      DestinationFiles="@(OpennessWorkerV20Files->'$(OutputPath)openness-worker\V20\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="RegisterOpennessWorkerPublishFiles" AfterTargets="ComputeFilesToPublish">
    <RemoveDir Directories="$(PublishDir)openness-worker" />
    <ItemGroup>
      <OpennessWorkerV21PublishFiles
        Include="..\TiaMcpServer.OpennessWorker\bin\V21\$(Configuration)\**\*.*"
        Exclude="..\TiaMcpServer.OpennessWorker\bin\V21\$(Configuration)\**\Siemens.Engineering*.dll;..\TiaMcpServer.OpennessWorker\bin\V21\$(Configuration)\**\*.runtimeconfig.json" />
      <OpennessWorkerV20PublishFiles
        Include="..\TiaMcpServer.OpennessWorker\bin\V20\$(Configuration)\**\*.*"
        Exclude="..\TiaMcpServer.OpennessWorker\bin\V20\$(Configuration)\**\Siemens.Engineering*.dll;..\TiaMcpServer.OpennessWorker\bin\V20\$(Configuration)\**\*.runtimeconfig.json" />

      <ResolvedFileToPublish Include="@(OpennessWorkerV21PublishFiles)">
        <RelativePath>openness-worker\V21\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>

      <ResolvedFileToPublish Include="@(OpennessWorkerV20PublishFiles)">
        <RelativePath>openness-worker\V20\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>